<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title> <link rel="stylesheet" href="style.css">
</head>
<body>
    <%-include('home')%>
<div class="addfrom">
   <form action="/addstudent" method="post">

    <h1>Full Name</h1>
    <input type="text" placeholder="Enter Full Name" name="name">
    <h1>Roll Number</h1>
    <input type="number" placeholder="eg.101" name="rollno">
    <h1>Phone Number</h1>
    <input type="number" placeholder="Enter Phone Number" name="phone">
    <h1>Email</h1>
    <input type="Email" placeholder="student@email.com" name="email">
    <h1>Course</h1>
    <input type="text" placeholder="Enter Course" name="course">
    <h1>Date of Birth</h1>
    <input type="date" placeholder="Enter Date of Birth" name="dob">
    <h1>Admission Date</h1>
    <input type="date" placeholder="Select Admission Date" name="date">
    <h1>Gender</h1>
    <select name="gender" id="">
        <option value="female">Female</option>
        <option value="male">Male</option>
    </select>
    <h1>Status</h1>
    <input type="radio" name="status" value="active" >
    <label for="active">Active</label>
    <input type="radio" name="status" value="Inactive" >
    <label for="Inactive">Inactive</label>

<button>SUBMIT FORM</button>
   </form>
   </div>
</body>
</html>