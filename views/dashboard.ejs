<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title> <link rel="stylesheet" href="style.css">
</head>
<body>
    <%-include('home')%>

   <div class="quickaction">
    <h1>Quick Actions</h1>
    <h3>Common tasks you want to perform</h3>
<div class="view">
<a href="/student">
     <span class="qa-icon qa-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </span>
    <h1>View All students</h1>
    <p>Browse and manage student records</p>
</a>
</div>
<div class="addnewstudent">
    <a href="/addstudent">
        <span class="qa-icon qa-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="8.5" cy="7" r="4"/>
                    <line x1="20" y1="8" x2="20" y2="14"/>
                    <line x1="23" y1="11" x2="17" y2="11"/>
                </svg>
            </span>
        <h1>Add new Student</h1>
        <p>Register a new student</p>
    </a>
</div>
<div class="manageCourses">
    <a href="/updatestudent">
        <span class="qa-icon qa-purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/>
                    <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>
                </svg>
            </span>
        <h1>View Courses</h1>
        <p>view  information</p>
    </a>

</div>
   </div>
   <div class="stats">
    <a href="/student" class="statcard">
        <div>
            <p>Total Students</p>
            <h2><%= total %></h2>
        </div>
        <span class="staticon st-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
    </a>

    <a href="/active" class="statcard">
        <div>
            <p>Active Students</p>
            <h2><%= active %></h2>
        </div>
        <span class="staticon st-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </span>
    </a>

    <a href="/inactive" class="statcard">
        <div>
            <p>Inactive Students</p>
            <h2><%= inactive %></h2>
        </div>
        <span class="staticon st-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>
        </span>
    </a>

    <div class="statcard">
        <div>
            <p>Total Courses</p>
            <h2><%= courses %></h2>
        </div>
        <span class="staticon st-purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v21a3 3 0 0 1 3-3h7z"/></svg>
        </span>
    </div>
</div>
</body>
</html>